#    / /| |/ / / / __  / / __/ __  /
#   / ___ / /_/ / /_/ / / /_/ /_/ /
#  /_/  |_\\__,_/\\__,_/_/\\__/\\__,_/
#
# Linux Audit Daemon — NixOS-Aware Best Practice Configuration
# /etc/audit/audit.rules
#
# BASE: Florian Roth's auditd rules (2023/01/25)
# HARDENED: Stripped of non-NixOS paths, trimmed by ~400 lines
# Sources: Neo23x0/auditd, linux-audit.com, Gov.uk puppet-auditd
#
# Key differences from upstream:
#   - All /etc/cron.* paths removed (NixOS uses systemd timers)
#   - SELinux, dpkg, rpm, pacman, snap, pip, npm, gem paths removed
#   - /etc/init.d/, /etc/inittab, /etc/sysconfig/ removed (systemd-only)
#   - /lib64/, /usr/lib64/ removed (NixOS doesn't use these)
#   - KDE4, gnome-pty-helper removed (KDE Plasma 6, not relevant)
#   - /sbin/auditctl, /usr/sbin/auditd (NixOS: /run/current-system/sw/bin/)
#   - Hardcoded /home/vanmanhacks/ replaced with /home/*/
#   - Added /nix/store/ watch for integrity monitoring
#   - Added /run/current-system/ watch for activation monitoring
#   - Added /etc/static/ watch for impermanence-aware NixOS configs

# Remove any existing rules
-D

# Buffer Size
## Increase to 16384 for high-volume systems; 8192 is fine for a workstation
-b 8192

# Failure Mode
## 0=silent, 1=printk, 2=panic
-f 1

# Ignore errors (missing paths, users not on system)
-i

# =============================================================================
# SELF AUDITING
# =============================================================================

## Audit the audit logs
-w /var/log/audit/ -p wra -k auditlog
-w /var/audit/ -p wra -k auditlog

## Auditd configuration
-w /etc/audit/ -p wa -k auditconfig
-w /etc/audisp/ -p wa -k audispconfig

## Monitor for use of audit management tools (NixOS paths)
-a always,exit -F path=/run/current-system/sw/bin/auditctl -F perm=x -k audittools
-a always,exit -F path=/run/current-system/sw/bin/ausearch -F perm=x -k audittools
-a always,exit -F path=/run/current-system/sw/bin/aureport -F perm=x -k audittools

# =============================================================================
# FILTERS (first-match-wins — keep these early)
# =============================================================================

## Ignore CWD records (noisy, low value)
-a always,exclude -F msgtype=CWD

## Ignore CRYPTO_KEY_USER (noisy on public-facing hosts)
-a always,exclude -F msgtype=CRYPTO_KEY_USER

## High-volume filters
-a never,exit -F arch=b64 -F dir=/dev/shm -k sharedmemaccess
-a never,exit -F arch=b64 -F dir=/var/lock/lvm -k locklvm

## Chrony time sync (avoid log flood)
-a never,exit -F arch=b64 -S adjtimex -F auid=-1 -F uid=chrony -F subj_type=chronyd_t

# =============================================================================
# NIXOS-SPECIFIC CONFIGURATION MONITORING
# =============================================================================

## NixOS configuration files
-w /etc/nixos/ -p wa -k nixos_config_change
-w /home/*/.nixfiles/ -p wa -k nixos_config_change

## Nix store integrity (rare writes, high value)
-w /nix/store/ -p wa -k nix_store

## NixOS system activation
-w /run/current-system/ -p wa -k nixos_activation

## Impermanence persisted configs (NixOS tmpfs root)
-w /etc/static/ -p wa -k nixos_static

## systemd unit files (NixOS managed)
-w /etc/systemd/system/ -p wa -k systemd_units
-w /run/current-system/sw/lib/systemd/system/ -p wa -k systemd_units

# =============================================================================
# KERNEL & MODULE MONITORING
# =============================================================================

## Kernel parameters
-w /etc/sysctl.d/ -p wa -k sysctl

## Kernel module loading/unloading
-a always,exit -F perm=x -F auid!=-1 -F path=/run/booted-system/sw/bin/insmod -k modules
-a always,exit -F perm=x -F auid!=-1 -F path=/run/booted-system/sw/bin/modprobe -k modules
-a always,exit -F perm=x -F auid!=-1 -F path=/run/booted-system/sw/bin/rmmod -k modules
-a always,exit -F arch=b64 -S finit_module -S init_module -S delete_module -F auid!=-1 -k modules

## Modprobe configuration
-w /etc/modprobe.d/ -p wa -k modprobe

## KExec usage
-a always,exit -F arch=b64 -S kexec_load -k KEXEC

## Special files
-a always,exit -F arch=b64 -S mknod -S mknodat -k specialfiles

## Mount operations (attributable only)
-a always,exit -F arch=b64 -S mount -S umount2 -F auid!=-1 -k mount

## Swap operations
-a always,exit -F arch=b64 -S swapon -S swapoff -F auid!=-1 -k swap

## Time changes
-a always,exit -F arch=b64 -F uid!=ntp -S adjtimex -S settimeofday -S clock_settime -k time
-w /etc/localtime -p wa -k localtime

# =============================================================================
# USER & AUTHENTICATION MONITORING
# =============================================================================

## User, group, password databases
-w /etc/group -p wa -k etcgroup
-w /etc/passwd -p wa -k etcpasswd
-w /etc/gshadow -k etcgroup
-w /etc/shadow -k etcpasswd
-w /etc/security/opasswd -k opasswd

## Sudoers (sudo-rs on NixOS uses same paths)
-w /etc/sudoers -p wa -k actions
-w /etc/sudoers.d/ -p wa -k actions

## Password changes
-w /run/current-system/sw/bin/passwd -p x -k passwd_modification

## Group/user modification tools
-w /run/current-system/sw/bin/groupadd -p x -k group_modification
-w /run/current-system/sw/bin/groupmod -p x -k group_modification
-w /run/current-system/sw/bin/useradd -p x -k user_modification
-w /run/current-system/sw/bin/usermod -p x -k user_modification
-w /run/current-system/sw/bin/userdel -p x -k user_modification

## Login configuration
-w /etc/login.defs -p wa -k login
-w /etc/securetty -p wa -k login
-w /var/log/faillog -p wa -k login
-w /var/log/lastlog -p wa -k login

# =============================================================================
# NETWORK MONITORING
# =============================================================================

## Hostname changes
-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_modifications

## Remote shell detection
-a always,exit -F arch=b64 -F exe=/run/current-system/sw/bin/bash -F success=1 -S connect -k remote_shell

## Successful IPv4 connections
-a always,exit -F arch=b64 -S connect -F a2=16 -F success=1 -F key=network_connect_4

## Successful IPv6 connections
-a always,exit -F arch=b64 -S connect -F a2=28 -F success=1 -F key=network_connect_6

## Network configuration files
-w /etc/hosts -p wa -k network_modifications
-w /etc/NetworkManager/ -p wa -k network_modifications
-w /etc/network/ -p wa -k network

## Issue files
-w /etc/issue -p wa -k etcissue
-w /etc/issue.net -p wa -k etcissue

# =============================================================================
# SYSTEM INTEGRITY
# =============================================================================

## Library search paths
-w /etc/ld.so.conf -p wa -k libpath
-w /etc/ld.so.conf.d/ -p wa -k libpath

## LD_PRELOAD (systemwide library injection)
-w /etc/ld.so.preload -p wa -k systemwide_preloads

## PAM configuration
-w /etc/pam.d/ -p wa -k pam
-w /etc/security/limits.conf -p wa -k pam
-w /etc/security/pam_env.conf -p wa -k pam
-w /etc/security/namespace.conf -p wa -k pam

## SSH configuration
-w /etc/ssh/sshd_config -k sshd
-w /etc/ssh/sshd_config.d/ -k sshd

## Root SSH key tampering
-w /root/.ssh/ -p wa -k rootkey

## Systemd monitoring
-w /run/current-system/sw/bin/systemctl -p x -k systemd
-w /etc/systemd/ -p wa -k systemd

## Critical file access failures
-a always,exit -F arch=b64 -S open -F dir=/etc -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/bin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/usr/bin -F success=0 -k unauthedfileaccess
-a always,exit -F arch=b64 -S open -F dir=/home -F success=0 -k unauthedfileaccess

# =============================================================================
# PRIVILEGE ESCALATION MONITORING
# =============================================================================

## su and sudo execution
-w /run/current-system/sw/bin/su -p x -k priv_esc
-w /run/current-system/sw/bin/sudo -p x -k priv_esc

## pkexec (CVE-2021-4034 and similar)
-w /run/current-system/sw/bin/pkexec -p x -k pkexec

## dbus-send (CVE-2021-3560)
-w /run/current-system/sw/bin/dbus-send -p x -k dbus_send

## Power state changes
-w /run/current-system/sw/bin/shutdown -p x -k power
-w /run/current-system/sw/bin/poweroff -p x -k power
-w /run/current-system/sw/bin/reboot -p x -k power
-w /run/current-system/sw/bin/halt -p x -k power

## DAC permission modifications (attributable, uid >= 1000)
-a always,exit -F arch=b64 -S chmod  -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S chown -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fchmod -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fchmodat -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fchown -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fchownat -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fremovexattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S fsetxattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S lchown -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S lremovexattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S lsetxattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S removexattr -F auid>=1000 -F auid!=-1 -k perm_mod
-a always,exit -F arch=b64 -S setxattr -F auid>=1000 -F auid!=-1 -k perm_mod

# =============================================================================
# RECONNAISSANCE DETECTION
# =============================================================================

-w /run/current-system/sw/bin/whoami -p x -k recon
-w /run/current-system/sw/bin/id -p x -k recon
-w /run/current-system/sw/bin/hostname -p x -k recon
-w /run/current-system/sw/bin/uname -p x -k recon
-w /etc/issue -p r -k recon
-w /etc/hostname -p r -k recon

# =============================================================================
# SUSPICIOUS ACTIVITY
# =============================================================================

## Download/transfer tools
-w /run/current-system/sw/bin/wget -p x -k susp_activity
-w /run/current-system/sw/bin/curl -p x -k susp_activity
-w /run/current-system/sw/bin/base64 -p x -k susp_activity

## Network tools
-w /run/current-system/sw/bin/nc -p x -k susp_activity
-w /run/current-system/sw/bin/ncat -p x -k susp_activity
-w /run/current-system/sw/bin/socat -p x -k susp_activity
-w /run/current-system/sw/bin/ssh -p x -k susp_activity
-w /run/current-system/sw/bin/scp -p x -k susp_activity
-w /run/current-system/sw/bin/sftp -p x -k susp_activity

## Network reconnaissance
-w /run/current-system/sw/bin/nmap -p x -k susp_activity
-w /run/current-system/sw/bin/tcpdump -p x -k sbin_susp
-w /run/current-system/sw/bin/wireshark -p x -k susp_activity
-w /run/current-system/sw/bin/tshark -p x -k susp_activity

## Firewall manipulation
-w /run/current-system/sw/bin/iptables -p x -k sbin_susp
-w /run/current-system/sw/bin/ip6tables -p x -k sbin_susp
-w /run/current-system/sw/bin/nft -p x -k sbin_susp

## Data compression (potential exfiltration staging)
-w /run/current-system/sw/bin/zip -p x -k Data_Compressed
-w /run/current-system/sw/bin/gzip -p x -k Data_Compressed
-w /run/current-system/sw/bin/tar -p x -k Data_Compressed
-w /run/current-system/sw/bin/bzip2 -p x -k Data_Compressed
-w /run/current-system/sw/bin/zstd -p x -k Data_Compressed

# =============================================================================
# SUSPICIOUS SHELLS (GTFOBins-aware)
# =============================================================================

-w /run/current-system/sw/bin/ash -p x -k susp_shell
-w /run/current-system/sw/bin/tmux -p x -k susp_shell
-w /run/current-system/sw/bin/rbash -p x -k susp_shell

## Shell profile tampering
-w /etc/profile.d/ -p wa -k shell_profiles
-w /etc/profile -p wa -k shell_profiles
-w /etc/shells -p wa -k shell_profiles
-w /etc/bashrc -p wa -k shell_profiles
-w /etc/zsh/ -p wa -k shell_profiles

# =============================================================================
# SESSION & LOG MONITORING
# =============================================================================

## Session initiation
-w /var/run/utmp -p wa -k session
-w /var/log/btmp -p wa -k session
-w /var/log/wtmp -p wa -k session
